{
  "name": "e-auction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test:auth": "node --experimental-strip-types --test tests/auth/**/*.test.ts",
    "test:auction": "node --env-file-if-exists=.env --experimental-strip-types --test tests/auction/**/*.test.ts",
    "db:migrate:dev": "prisma migrate dev --name initial_platform_schema",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react": "^7.37.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
