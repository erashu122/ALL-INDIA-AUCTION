# PostgreSQL connection string used by Prisma. Do not commit production credentials.
DATABASE_URL="postgresql://username:password@localhost:5432/e_auction?schema=public"

# Random secret (32+ characters) used to sign HTTP-only authentication sessions.
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Development-only local storage root. Keep it outside the repository and never under /public.
LOCAL_FILE_STORAGE_DIRECTORY=""
FILE_DOCUMENT_MAX_BYTES="10485760"
FILE_MEDIA_MAX_BYTES="52428800"

# Development-only seed guard. It must exactly match the shown value to enable db:seed.
ALLOW_DEVELOPMENT_SEED="seed-local-development"

# Development-only passwords for fake, test-domain authentication users. Do not commit values.
DEV_SEED_SUPER_ADMIN_PASSWORD=""
DEV_SEED_ADMIN_PASSWORD=""
DEV_SEED_CLIENT_PASSWORD=""
DEV_SEED_VENDOR_PASSWORD=""
DEV_SEED_SUPPORT_PASSWORD=""
